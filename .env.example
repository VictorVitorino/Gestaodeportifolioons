VITE_APP_ENV=development
VITE_DATA_PROVIDER=supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Compatibilidade opcional com runtime config sem Vite:
# APP_ENV=development
# DATA_PROVIDER=supabase
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=

# Nunca adicionar SUPABASE_SERVICE_ROLE_KEY, senha PostgreSQL ou segredo administrativo no frontend.
# Segredos server-side futuros devem existir apenas no ambiente seguro do backend/Edge Function.
